# TravelGuide deployment/runtime configuration
#
# Copy this file to .env for local Docker Compose or provide the same
# variables through your deployment platform.

# UI/runtime defaults
TRAVELGUIDE_LANGUAGE="en"
# Options: browser, minimax
TRAVELGUIDE_TTS_PROVIDER="browser"

# Required for AI POI selection, guide writing, images, and MiniMax TTS.
MINIMAX_API_KEY="your_minimax_api_key"
BRAVE_API_KEY="your_brave_search_api_key"

# Optional backend settings
APP_SECRET="change-me"
MINIMAX_MODEL="MiniMax-M2.7"
MINIMAX_TTS_MODEL="speech-2.8-hd"
MINIMAX_TTS_VOICE_ID="moss_audio_32c53f56-4606-11f1-8416-56cb9cf1b830"
MINIMAX_BASE_URL="https://api.minimax.io"
BRAVE_BASE_URL="https://api.search.brave.com"
OVERPASS_URL="https://overpass-api.de/api/interpreter"
